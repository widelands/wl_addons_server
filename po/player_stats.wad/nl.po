#: input:6 standard
msgid "Player statistics"
msgstr "Spelersstatistieken"

#: input:6 standard
msgid "Show detailed statistics on each player’s wares and buildings."
msgstr ""
"Toon gedetailleerde statistieken over de goederen en gebouwen van elke "
"speler."

#: input:8 standard
msgid "Player Statistics"
msgstr "Spelersstatistieken"

#: input:12 standard
