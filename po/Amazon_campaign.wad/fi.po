#: addons/Amazon_campaign.wad/addon:6 input:6 standard
msgid ""
"This is the story of the rise of Pachiquima, an amazon from a small mountain "
"village."
msgstr "Tämä tarina on Pachiquiman noususta, amatsoni pienestä vuorikylästä."

#: addons/Amazon_campaign.wad/addon:9 input:9 standard
msgid "Amazon_campaign"
msgstr ""

#: addons/Amazon_campaign.wad/campaigns.lua:18 input:18 standard
msgid "Medium."
msgstr "Kohtalainen"

#: addons/Amazon_campaign.wad/campaigns.lua:30 input:30 standard
msgid "The Rise to Power"
msgstr "Valtaannousu"

#: addons/Amazon_campaign.wad/campaigns.lua:32 input:32 standard
msgid "Introduces the amazons"
msgstr "Amatsonien esittely"

#. TRANSLATORS: A campaign difficulty (easiest of three options)
#: addons/Amazon_campaign.wad/campaigns.lua:37 input:37 standard
msgid "Easy"
msgstr "Helppo"

#. TRANSLATORS: A campaign difficulty (medium of three options)
#: addons/Amazon_campaign.wad/campaigns.lua:39 input:39 standard
msgid "Medium"
msgstr "Kohtalainen"

#. TRANSLATORS: A campaign difficulty (hardest of three options)
#: addons/Amazon_campaign.wad/campaigns.lua:41 input:41 standard
